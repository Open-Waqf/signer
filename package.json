{
  "name": "signer",
  "private": true,
  "version": "0.41.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=phone --project=phone-ar",
    "test:all": "playwright test",
    "test:build": "npm run build && TEST_BUILD=1 playwright test",
    "check": "node scripts/check.mjs",
    "check-i18n": "node check-i18n.js",
    "android:run": "node scripts/run-android.mjs",
    "android:live": "node scripts/run-android.mjs --live",
    "android:release": "node scripts/release-android.mjs",
    "release": "node scripts/release.mjs",
    "test:android": "node scripts/test-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.64.0",
    "@types/node": "^25.9.9",
    "@types/qrcode": "^1.5.6",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "buffer": "6.0.3",
    "lit": "3.3.3",
    "node-forge": "1.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "^1.5.4"
  }
}
